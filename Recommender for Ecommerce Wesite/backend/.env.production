# Environment Variables for Render Deployment
# Copy these to your Render service environment variables

# Django Settings
SECRET_KEY=your-very-long-secret-key-here-generate-a-new-one
DJANGO_SETTINGS_MODULE=config.settings.production

# Database (if using PostgreSQL on Render)
# DATABASE_URL will be automatically set by Render PostgreSQL add-on

# Or MySQL (if using external MySQL)
# DB_NAME=bookverse
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
# DB_HOST=your_db_host
# DB_PORT=3306

# CORS (replace with your actual Vercel domain)
FRONTEND_URL=https://your-frontend.vercel.app
